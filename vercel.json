{
  "version": 2,
  "builds": [
    {
      "src": "api/classroom.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "lib/**"
        ]
      }
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/classroom/?",
      "dest": "/api/classroom.js"
    },
    {
      "src": "/",
      "dest": "/public/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
