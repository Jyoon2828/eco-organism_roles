{
  "version": 2,
  "builds": [
    {
      "src": "api/classroom.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "lib/**"
        ]
      }
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/classroom/?",
      "dest": "/api/classroom.js"
    },
    {
      "src": "/",
      "dest": "/public/index.html",
      "headers": {
        "Cache-Control": "no-cache, max-age=0, must-revalidate"
      }
    },
    {
      "src": "/(index|teacher|display)\\.html",
      "dest": "/public/$1.html",
      "headers": {
        "Cache-Control": "no-cache, max-age=0, must-revalidate"
      }
    },
    {
      "src": "/(app(?:-20261019(?:-9)?)?|display-20261019|data|learning)\\.js",
      "dest": "/public/$1.js",
      "headers": {
        "Cache-Control": "no-cache, max-age=0, must-revalidate"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
